{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node, not the browser: this package holds the entity API key and speaks
    // HTTP. `undici`'s fetch is built in from Node 18, so there is no HTTP
    // client dependency.
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
